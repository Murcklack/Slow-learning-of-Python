// 1. Вставляем все страницы старого PDF (например, их 5)
#set page(margin: 0pt)
#for p in range(1, 17) { // range(1, N+1), где N — число страниц
  image("RGR1.pdf", page: p, width: 100%, height: 100%)
}

// 2. Возвращаем стандартные настройки страницы для нового текста
#set page(
  paper: "a4",
  margin: (x: 20mm, y: 20mm),
)

// 3. Пишем продолжение документа
= Продолжение документа
Здесь начинается ваш новый текст, который пойдет со следующей страницы.